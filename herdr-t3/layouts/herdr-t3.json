{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "t3-chrome"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "limits",
          "type": "block",
          "content": {
            "mod": "t3-limits",
            "props": {
              "node": "limits"
            }
          },
          "size": {
            "px": 112
          }
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "children": [
            {
              "id": "lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "t3-spaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "t3-agents"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            },
            {
              "id": "focus",
              "type": "block",
              "content": {
                "mod": "t3-focus",
                "props": {
                  "newMenu": "t3-new-menu"
                }
              }
            }
          ],
          "active": "lists"
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "t3-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 41
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "t3-tabs"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "view",
              "type": "stack",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "t3-pane"
                        },
                        "reveal": "always",
                        "height": 28,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 2,
                        "color": "background"
                      },
                      "focus": {
                        "width": 2,
                        "color": "background"
                      },
                      "radius": 8,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "agent",
                  "type": "block",
                  "content": {
                    "agent": "focused"
                  },
                  "background": "background",
                  "radius": 8
                }
              ],
              "active": "main"
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": [
            2,
            8
          ],
          "gap": 8
        },
        {
          "id": "work-bottom-inset",
          "type": "row",
          "children": [],
          "size": {
            "px": 6
          }
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "hidden": true
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    8,
    0
  ],
  "terminal_opacity": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    16,
    13
  ],
  "preview": "layouts/herdr-t3.svg"
}
